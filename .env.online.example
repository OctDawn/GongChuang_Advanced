# 线上赛段专用配置（24 件 / 3 分钟）。
#
# 用法（一定要先备份，拍完换回来）：
#   cp .env .env.offline.bak
#   cp .env.online.example .env        # 再填上你自己的 key
#   sudo systemctl restart wave-vision-llm     # 或手动跑 python main_online.py
# 拍完后：cp .env.offline.bak .env && sudo systemctl restart wave-vision-llm
#
# ⚠️ 不要在 .env 里“追加”重复的键：本项目 shared/dotenv.py 按“先出现的优先”，
#    systemd EnvironmentFile 却是“后出现的优先”，两者行为相反，很容易改了半天不生效。
#    要改就改原来那一行。

# ============ 线上模式开关 ============
ONLINE_MODE=1
ONLINE_BATCH_TIMEOUT=40

# ============ 走国内 API（免代理，省一跳）============
# 阿里云百炼 / DashScope 兼容模式：支持 /chat/completions + image_url
# 注意：兼容模式没有 responses / prompt_cache 字段，所以必须用 portable
DASHSCOPE_API_KEY=填你自己的-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-plus
LLM_CACHE_MODE=portable
LLM_REASONING_EFFORT=off
LLM_SERVICE_TIER=
# 国内接口直连：一行代理都不要留（留了会绕一圈，反而慢、还可能连不上）
# HTTPS_PROXY=
# HTTP_PROXY=

# ============ 速度优先的图片参数 ============
# 整盘只发一张，尺寸可以比线下小；六张参考图压得更狠
LLM_MAX_SIDE=1024
LLM_REF_MAX_SIDE=384
LLM_JPEG_QUALITY=88

# ============ 串口 / 显示沿用线下配置 ============
# SERIAL_PORT / BAUDRATE 在 shared/const.py，不在这里
SCREEN_OFF_UNTIL_START=1
YOLO_FALLBACK=0
