[Unit]
Description=Wave Vision Classification System (YOLO / RKNN)
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=orangepi
Group=orangepi
# 仓库路径按实际修改
WorkingDirectory=/home/orangepi/WaveRider_GongChuang_Vision
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/orangepi/.Xauthority
# conda 环境名按实际修改（YOLO 版需 rknnlite 环境）
ExecStart=/bin/bash -c 'source /home/orangepi/miniconda3/bin/activate && conda activate rknn && exec python -u main_push_yolo.py'
# 主程序捕获摄像头/串口故障后可能正常退出，因此正常退出也需要重启
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
