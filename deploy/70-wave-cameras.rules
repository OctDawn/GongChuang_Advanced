# 智能分拣 相机固定别名（4 路）
#
# 安装：
#   sudo cp deploy/70-wave-cameras.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=video4linux --action=add
#   ls -l /dev/wave/          # 应出现 cam_pallet + cam_detect_1/2/3
#
# 为什么按 USB 物理口（ENV{ID_PATH}）而不是 by-id：
#   两台相机 USB 描述符完全相同（0bda:9143，假序列号都是 200901010001），
#   by-id 名字会撞车，其中一台干脆没有 by-id 名字。
#
# 两个必须遵守的写法（都踩过）：
#   1) 属性必须包在 ENV{} 里。写成 ID_PATH=="..." 会被 udev 判成 Invalid key，
#      并且 **静默丢弃整条规则**（不报错，只是别名一直不出现）。
#   2) 必须加 ATTR{index}=="0"。每台 UVC 相机同时暴露 index0(采集) 与 index1(metadata)，
#      两者 ID_PATH 相同；不加判断，别名会被后一个覆盖，指过去打不开。
#
# 换 USB 口后：用
#   udevadm info -q property -n /dev/videoN | grep '^ID_PATH='
# 拿到新值，改这里的 ID_PATH 即可（代码里的 /dev/wave/cam_* 不用动）。
# 当前绑定与 README「相机与设备别名」、shared/const.py 的注释是同一份真相，改线后三处一起更新。

# 托盘上方广角（1280x960）
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="platform-fc800000.usb-usb-0:1.2:1.0", SYMLINK+="wave/cam_pallet"
# 识别区① 斜上方（俯约 45°）
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="platform-fc800000.usb-usb-0:1.1:1.0", SYMLINK+="wave/cam_detect_1"
# 识别区② 斜上方（与①相对）
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="platform-fc880000.usb-usb-0:1.3:1.0", SYMLINK+="wave/cam_detect_2"
# 识别区③ 正下方仰视（看底面）
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="platform-fc880000.usb-usb-0:1.4:1.0", SYMLINK+="wave/cam_detect_3"
